nextflow.enable.dsl = 2

params {
  outdir  = "results"
  workdir = null

  // Optional: override the NCBITaxa sqlite path (null = ete3 default ~/.etetoolkit/taxa.sqlite)
  ncbi_taxa_db     = null

  // FASTA output line width for combined_input_fasta.fa (characters per line)
  fasta_line_width = 60

  // Set to a previous outdir to skip clustering steps (1–4)
  existing_clusters_dir = null

  // Input FASTA dir (optional; base dir for relative file_path entries in metadata TSV)
  input_fasta_dir  = null

  // Include singleton proteins in the final all_relatives FASTA.
  // Singletons (proteins whose cluster contained only one sequence) are
  // low-support but provide coverage for rare or divergent families.
  // Set to false to produce ranked-only output.
  with_singletons = true

  // Deduplicate exact-sequence duplicates in the final all_relatives FASTA.
  // Off by default — the manifest records all selected proteins and is unaffected.
  // Enable to reduce FASTA size for downstream processing. When enabled, a
  // dedup_report.tsv is written per query listing dropped headers and their duplicates.
  dedup_sequences = false
}

workDir = params.workdir ? params.workdir : "work"

// Global defaults (apply to all profiles unless overridden)
process {
  shell = ["/bin/bash", "-ueo", "pipefail"]
}

profiles {

  docker {
    docker.enabled    = true
    docker.runOptions = '--platform linux/amd64'
    process.container = 'ghcr.io/simarpreet-kaur-bhurji/echo-container:latest'
  }

  singularity {
    singularity.enabled    = true
    singularity.autoMounts = true
    process.container      = 'docker://ghcr.io/simarpreet-kaur-bhurji/echo-container:latest'
  }
  
  local {
    process.executor = "local"

    // keep local tiny
    process.cpus   = 1
    process.memory = "4 GB"
    process.time   = "1h"

    // optional: avoid surprise retries locally
    process.errorStrategy = "terminate"
    process.maxRetries    = 0
  }

  slurm {
    process.executor = "slurm"

    /*
     * Global defaults + automatic retries
     * (applies to ALL processes in slurm unless overridden)
     */
    process {
      // Baseline resources with per-attempt ramp
      cpus   = 1
      memory = { 16.GB * task.attempt }     // 16, 32, 48 GB
      time   = { 2.h  * task.attempt }      // 2, 4, 6 hours

      // Retry policy
      errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
      maxRetries    = 3
    }

    /*
     * Heavy step overrides
     */
    process {
      withName: RUN_MMSEQS {
        cpus   = 16
        memory = { 64.GB * task.attempt }   // 64, 128, 192 GB
        time   = { 12.h * task.attempt }    // 12, 24, 36 h
      }

      withName: PARSE_INPUT_FASTA {
        cpus   = 4
        memory = { 32.GB * task.attempt }   // 32, 64, 96 GB
        time   = { 4.h  * task.attempt }    // 4, 8, 12 h
      }

      withName: PARSE_CLUSTERS {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 6.h  * task.attempt }
      }

      withName: PROCESS_CLUSTERS {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 2.h  * task.attempt }
      }

      withName: CLOSEST_RELATIVES_CHUNK {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 4.h  * task.attempt }
      }

      withName: MAKE_DIAGNOSTICS {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 4.h  * task.attempt }
      }
    }
  }
}

