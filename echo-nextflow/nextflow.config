nextflow.enable.dsl = 2

params {
  outdir  = "results"
  workdir = null
}

workDir = params.workdir ? params.workdir : "work"

// Global defaults (apply to all profiles unless overridden)
process {
  shell = ["/bin/bash", "-ueo", "pipefail"]
}

profiles {

  local {
    process.executor = "local"

    // keep local tiny
    process.cpus   = 1
    process.memory = "4 GB"
    process.time   = "1h"

    // optional: avoid surprise retries locally
    process.errorStrategy = "terminate"
    process.maxRetries    = 0
  }

  slurm {
    process.executor = "slurm"

    /*
     * Global defaults + automatic retries
     * (applies to ALL processes in slurm unless overridden)
     */
    process {
      // Baseline resources with per-attempt ramp
      cpus   = 1
      memory = { 16.GB * task.attempt }     // 16, 32, 48 GB
      time   = { 2.h  * task.attempt }      // 2, 4, 6 hours

      // Retry policy
      errorStrategy = { task.attempt <= 3 ? 'retry' : 'terminate' }
      maxRetries    = 3
    }

    /*
     * Heavy step overrides
     */
    process {
      withName: RUN_MMSEQS {
        cpus   = 16
        memory = { 64.GB * task.attempt }   // 64, 128, 192 GB
        time   = { 12.h * task.attempt }    // 12, 24, 36 h
      }

      withName: PARSE_INPUT_FASTA {
        cpus   = 4
        memory = { 32.GB * task.attempt }   // 32, 64, 96 GB
        time   = { 4.h  * task.attempt }    // 4, 8, 12 h
      }

      withName: PARSE_CLUSTERS {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 6.h  * task.attempt }
      }

      withName: PROCESS_CLUSTERS {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 2.h  * task.attempt }
      }

      withName: CLOSEST_RELATIVES_CHUNK {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 4.h  * task.attempt }
      }

      withName: MAKE_DIAGNOSTICS {
        cpus   = 2
        memory = { 16.GB * task.attempt }
        time   = { 4.h  * task.attempt }
      }
    }
  }
}

